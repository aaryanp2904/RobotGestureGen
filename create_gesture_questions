#!/usr/bin/env python3
"""Create BEAT2 gesture-question folders with four model predictions.

Default mode (run from your laptop):
  1. One SSH session on the remote GPU machine (sync script + run all inference).
  2. One recursive scp that pulls the full output directory back locally.

Use --worker only when invoked on the remote machine itself.
"""

