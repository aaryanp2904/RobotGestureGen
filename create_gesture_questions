def build_remote_worker_command(args: argparse.Namespace) -> str:
    setup = f"{args.remote_setup} && " if args.remote_setup else ""
    worker_script = f"{args.remote_repo}/create_gesture_questions"
    worker_argv = " ".join(shlex.quote(part) for part in build_worker_argv(args))
    return (
        f"cd {remote_quote(args.remote_repo)} && "
        f"{setup}"
        f"mkdir -p {remote_quote(args.remote_output_dir)} && "
        f"{remote_quote(args.remote_python)} {remote_quote(worker_script)} {worker_argv}"
    )


def apply_remote_defaults(args: argparse.Namespace) -> None:
    beat_root = args.remote_beat_root.rstrip("/")
    args.split_csv = remote_path(beat_root, "train_test_split.csv")
    args.audio_dir = remote_path(beat_root, "wave16k")
    args.textgrid_dir = remote_path(beat_root, "textgrid")
    if args.remote_output_dir is None:
        stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        args.remote_output_dir = remote_path(DEFAULT_REMOTE_OUTPUT_ROOT, stamp)


def orchestrator_main(args: argparse.Namespace) -> None:
    apply_remote_defaults(args)
    local_dir = Path(args.output_dir)
    local_dir.mkdir(parents=True, exist_ok=True)

    if args.dry_run:
        run_remote_worker_session(args)
        print(
            f"[DRY-RUN] Single scp pull: "
            f"{args.remote}:{args.remote_output_dir}/ -> {local_dir.resolve()}"
        )
        if not args.keep_remote_output:
            print(f"[DRY-RUN] Would remove remote output: {args.remote_output_dir}")
        return

    ensure_ssh_control_dir(args)
    print(f"[REMOTE] Running worker on {args.remote}")
    print(f"[REMOTE] Output directory: {args.remote_output_dir}")
    run_remote_worker_session(args)

    print(f"\n[LOCAL] Destination: {local_dir.resolve()}")
    pull_all_folders_via_scp(args, local_dir)

    if not args.keep_remote_output:
        cleanup_remote_output(args)

    print(f"\n[DONE] Gesture question folders copied to: {local_dir.resolve()}")


def add_shared_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--num-clips", type=int, default=10)
    parser.add_argument("--clip-id", action="append", help="Explicit clip ID; repeat to bypass random sampling")
    parser.add_argument("--split-csv")
    parser.add_argument("--split", default="test")
    parser.add_argument("--audio-dir")
    parser.add_argument("--textgrid-dir")
    parser.add_argument("--output-dir", default="gesture_questions")
    parser.add_argument("--seed", type=int, default=None, help="Random seed for clip selection")
    parser.add_argument("--inference-seed", type=int, default=None, help="Seed passed to inference scripts")
    parser.add_argument(
        "--allow-incomplete-assets",
        dest="only_complete_assets",
        action="store_false",
        help="Allow randomly selected clips even if WAV/TextGrid files are missing",
    )
    parser.add_argument("--allow-missing-textgrid", action="store_true")
    parser.add_argument("--dry-run", action="store_true")

    parser.add_argument("--diffusion-checkpoint", default=DIFFUSION_CHECKPOINT)
    parser.add_argument("--diffusion-stats", default=DIFFUSION_STATS)
    parser.add_argument("--latent-diffusion-checkpoint", default=LATENT_DIFFUSION_CHECKPOINT)
    parser.add_argument("--latent-diffusion-stats", default=LATENT_DIFFUSION_STATS)
    parser.add_argument("--transformers-checkpoint", default=TRANSFORMER_CHECKPOINT)
    parser.add_argument("--transformers-stats", default=TRANSFORMER_STATS)
    parser.add_argument("--transformers-delta-checkpoint", default=TRANSFORMER_DELTA_CHECKPOINT)
    parser.add_argument("--transformers-delta-stats", default=TRANSFORMER_DELTA_STATS)

    parser.add_argument("--fps", type=int, default=30)
    parser.add_argument("--window-size", type=float, default=2.0)
    parser.add_argument("--stride", type=float, default=0.5)
    parser.add_argument("--sample-steps", type=int, default=50)
    parser.add_argument("--guidance-scale", type=float, default=1.0)
    parser.add_argument("--diffusion-sampler", choices=["ddpm", "ddim"], default="ddpm")
    parser.add_argument("--latent-sampler", choices=["ddpm", "ddim"], default="ddim")
    parser.add_argument("--diffusion-deterministic", action="store_true")
    parser.add_argument("--diffusion-seed-frames", type=int, default=None)
    parser.add_argument("--speaker-id", default=None)
    parser.add_argument("--smooth-window", type=int, default=1)
    parser.add_argument("--latent-smooth-window", type=int, default=7)
    parser.add_argument("--velocity-limit", action="store_true")
    parser.add_argument("--velocity-scale", type=float, default=1.0)
    parser.add_argument("--disable-energy-gate", dest="energy_gate", action="store_false", default=True)
    parser.add_argument("--rest-blend", type=float, default=0.7)
    parser.add_argument("--text-cpu", action="store_true")
    parser.add_argument("--wavlm-cpu", action="store_true")
    parser.add_argument("--continue-on-error", action="store_true")
    parser.set_defaults(only_complete_assets=True)


def add_orchestrator_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--remote", default=DEFAULT_REMOTE)
    parser.add_argument("--jump-host", default=DEFAULT_JUMP_HOST)
    parser.add_argument("--remote-repo", default=DEFAULT_REMOTE_REPO)
    parser.add_argument("--remote-beat-root", default=DEFAULT_REMOTE_BEAT)
    parser.add_argument("--remote-output-dir", default=None, help="Remote staging directory before scp pull")
    parser.add_argument("--remote-python", default=DEFAULT_REMOTE_PYTHON)
    parser.add_argument("--remote-setup", default="", help="Shell snippet to run before remote worker")
    parser.add_argument("--keep-remote-output", action="store_true", help="Do not delete remote staging directory")
    parser.add_argument(
        "--no-sync-script",
        action="store_true",
        help="Use the create_gesture_questions already present on the remote repo",
    )
    parser.add_argument("--no-ssh-reuse", action="store_true")
    parser.add_argument("--ssh-control-path", default=DEFAULT_SSH_CONTROL_PATH)
    parser.add_argument("--ssh-control-persist", default=DEFAULT_SSH_CONTROL_PERSIST)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Choose random BEAT2 test clips, run all four model inferences on a remote GPU "
            "machine, and pull one folder per clip to your local machine."
        )
    )
    parser.add_argument(
        "--worker",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--local-only",
        action="store_true",
        help="Run inference on this machine instead of using SSH (for debugging on the GPU host)",
    )
    add_shared_args(parser)
    add_orchestrator_args(parser)
    return parser.parse_args()


def validate_args(args: argparse.Namespace) -> None:
    if args.num_clips <= 0:
        raise ValueError("--num-clips must be positive")
    if args.fps <= 0:
        raise ValueError("--fps must be positive")
    if args.window_size <= 0 or args.stride <= 0:
        raise ValueError("--window-size and --stride must be positive")
    if args.sample_steps <= 0:
        raise ValueError("--sample-steps must be positive")
    if args.guidance_scale < 0:
        raise ValueError("--guidance-scale cannot be negative")
    if args.diffusion_seed_frames is not None and args.diffusion_seed_frames < 0:
        raise ValueError("--diffusion-seed-frames cannot be negative")
    if args.smooth_window < 1:
        raise ValueError("--smooth-window must be at least 1")
    if args.latent_smooth_window < 1:
        raise ValueError("--latent-smooth-window must be at least 1")
    if args.velocity_scale <= 0:
        raise ValueError("--velocity-scale must be positive")
    if not 0.0 <= args.rest_blend <= 1.0:
        raise ValueError("--rest-blend must be in [0, 1]")


def main() -> None:
    args = parse_args()
    validate_args(args)

    if args.worker or args.local_only:
        if args.worker:
            if not args.split_csv or not args.audio_dir or not args.textgrid_dir:
                raise ValueError("--worker requires --split-csv, --audio-dir, and --textgrid-dir")
        else:
            from BEATArc.config import AUDIO_DIR, SPLIT_CSV, TEXTGRID_DIR

            args.split_csv = args.split_csv or str(SPLIT_CSV)
            args.audio_dir = args.audio_dir or str(AUDIO_DIR)
            args.textgrid_dir = args.textgrid_dir or str(TEXTGRID_DIR)
        worker_main(args)
        return

    orchestrator_main(args)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as exc:
        print(f"[ERROR] Command failed with exit code {exc.returncode}", file=sys.stderr)
        sys.exit(exc.returncode)
