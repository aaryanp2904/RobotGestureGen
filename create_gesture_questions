    ),
    ModelSpec(
        "transformers_delta",
        "transformers_delta_checkpoint",
        "transformers_delta_stats",
        "machine_learning.transformers_delta.inference",
    ),
)


def run_command(command: list[str], dry_run: bool = False) -> None:
    printable = " ".join(shlex.quote(part) for part in command)
    print(f"[CMD] {printable}")
    if not dry_run:
        subprocess.run(command, check=True)


def remote_quote(value: str) -> str:
    return shlex.quote(value)


def remote_path(base: str, *parts: str) -> str:
    """Join Linux remote paths without Windows Path normalization."""
    path = base.rstrip("/")
    for part in parts:
        if part:
            path = posixpath.join(path, part.strip("/"))
    return path


def ssh_reuse_options(args: argparse.Namespace) -> list[str]:
    if args.no_ssh_reuse or os.name == "nt":
        return []
    return [
        "-o",
        "ControlMaster=auto",
        "-o",
        f"ControlPersist={args.ssh_control_persist}",
        "-o",
        f"ControlPath={args.ssh_control_path}",
    ]


def ensure_ssh_control_dir(args: argparse.Namespace) -> None:
    if args.no_ssh_reuse or args.dry_run:
        return
    Path(args.ssh_control_path).expanduser().parent.mkdir(parents=True, exist_ok=True)


def ssh_command(args: argparse.Namespace, remote_command: str) -> list[str]:
    command = ["ssh"]
    command.extend(ssh_reuse_options(args))
    if args.jump_host:
        command.extend(["-J", args.jump_host])
    command.extend([args.remote, remote_command])
    return command


def pull_all_folders_via_scp(args: argparse.Namespace, local_dir: Path) -> None:
    """Pull every clip folder in a single recursive scp transfer."""
    local_dir.mkdir(parents=True, exist_ok=True)
    remote_spec = f"{args.remote}:{args.remote_output_dir}/"
    command = ["scp", "-r"]
    command.extend(ssh_reuse_options(args))
    if args.jump_host:
        command.extend(["-o", f"ProxyJump={args.jump_host}"])
    command.extend([remote_spec, str(local_dir)])
    print("[LOCAL] Pulling all clip folders in one scp transfer")
    run_command(command, dry_run=args.dry_run)


def run_remote_worker_session(args: argparse.Namespace) -> None:
    """Sync the worker script and run inference in a single SSH session."""
    remote_script = f"{args.remote_repo}/create_gesture_questions"
    parts = []
    if not args.no_sync_script:
        parts.append(f"cat > {remote_quote(remote_script)}")
        parts.append(f"chmod +x {remote_quote(remote_script)}")
    parts.append(build_remote_worker_command(args))
    remote_shell = " && ".join(parts)
    command = ssh_command(args, remote_shell)

    if args.dry_run:
        print("[DRY-RUN] Single SSH session (sync script + worker):")
        print(" ".join(shlex.quote(part) for part in command))
        if not args.no_sync_script:
            print(f"[DRY-RUN] Script stdin: {REPO_ROOT / 'create_gesture_questions'}")
        return

    stdin = None
    if not args.no_sync_script:
        script_bytes = (REPO_ROOT / "create_gesture_questions").read_bytes().replace(b"\r\n", b"\n")
        stdin = io.BytesIO(script_bytes)
    try:
        print("[REMOTE] Single SSH session: sync script + run worker")
        subprocess.run(command, stdin=stdin, check=True)
    finally:
        if stdin is not None:
            stdin.close()


def cleanup_remote_output(args: argparse.Namespace) -> None:
    cleanup_command = f"rm -rf {remote_quote(args.remote_output_dir)}"
    print(f"[REMOTE] Cleaning up: {args.remote_output_dir}")
    run_command(ssh_command(args, cleanup_command), dry_run=args.dry_run)


def read_test_clip_ids(split_csv: Path, split: str) -> list[str]:
    with open(split_csv, "r", newline="") as f:
        rows = csv.DictReader(f)
        clip_ids = [row["id"] for row in rows if row.get("type") == split and row.get("id")]
    if not clip_ids:
        raise RuntimeError(f"No {split!r} clips found in {split_csv}")
    return clip_ids


def choose_clip_ids(args: argparse.Namespace) -> list[str]:
    if args.clip_id:
        return list(dict.fromkeys(args.clip_id))

    clip_ids = read_test_clip_ids(Path(args.split_csv), args.split)
    if args.only_complete_assets:
        clip_ids = [
            clip_id
            for clip_id in clip_ids
            if (Path(args.audio_dir) / f"{clip_id}.wav").is_file()
            and (Path(args.textgrid_dir) / f"{clip_id}.TextGrid").is_file()
        ]
    if len(clip_ids) < args.num_clips:
        raise RuntimeError(f"Need {args.num_clips} clips, but only found {len(clip_ids)} eligible clips")

    rng = random.Random(args.seed)
    return rng.sample(clip_ids, args.num_clips)


def copy_asset(src: Path, dst: Path, required: bool) -> None:
    if src.is_file():
        shutil.copy2(src, dst)
        return
    if required:
        raise FileNotFoundError(f"Missing required asset: {src}")
    print(f"[WARN] Missing asset, skipping: {src}")


def build_common_args(args: argparse.Namespace, clip_id: str, output_path: Path) -> dict:
    return {
        "checkpoint": None,
        "stats": None,
        "output": str(output_path),
        "wav": None,
        "textgrid": None,
        "clip_id": clip_id,
        "audio_dir": args.audio_dir,
        "textgrid_dir": args.textgrid_dir,
        "fps": args.fps,
        "window_size": args.window_size,
        "stride": args.stride,
        "seed": args.inference_seed,
        "smooth_window": args.smooth_window,
        "velocity_limit": args.velocity_limit,
        "velocity_scale": args.velocity_scale,
        "text_cpu": args.text_cpu,
        "wavlm_cpu": args.wavlm_cpu,
    }


def run_model_inference(args: argparse.Namespace, spec: ModelSpec, clip_id: str, clip_dir: Path) -> None:
    output_path = clip_dir / f"{spec.name}.npy"
    infer_args = build_common_args(args, clip_id, output_path)
    infer_args["checkpoint"] = getattr(args, spec.checkpoint_attr)
    infer_args["stats"] = getattr(args, spec.stats_attr)

    if spec.name == "diffusion":
        from machine_learning.diffusion.inference import generate

        infer_args.update(
            {
                "speaker_id": args.speaker_id,
                "sampler": args.diffusion_sampler,
                "sample_steps": args.sample_steps,
                "guidance_scale": args.guidance_scale,
                "diffusion_deterministic": args.diffusion_deterministic,
                "diffusion_seed_frames": args.diffusion_seed_frames,
            }
        )
    elif spec.name == "latent_diffusion":
        from machine_learning.latent_diffusion.infer_nao import generate

        infer_args.update(
            {
                "speaker_id": args.speaker_id,
                "sampler": args.latent_sampler,
                "sample_steps": args.sample_steps,
                "guidance_scale": args.guidance_scale,
                "diffusion_deterministic": args.diffusion_deterministic,
                "diffusion_seed_frames": args.diffusion_seed_frames,
                "energy_gate": args.energy_gate,
                "rest_blend": args.rest_blend,
                "smooth_window": args.latent_smooth_window,
            }
        )
    elif spec.name == "transformers":
        from machine_learning.transformers.inference import generate
    elif spec.name == "transformers_delta":
        from machine_learning.transformers_delta.inference import generate
    else:
        raise ValueError(f"Unknown model spec: {spec.name}")

    print(f"[INFER] {clip_id}: {spec.name}")
    generate(argparse.Namespace(**infer_args))


def write_manifest(args: argparse.Namespace, clip_ids: list[str], output_dir: Path) -> None:
    manifest = {
        "clip_ids": clip_ids,
        "split_csv": str(args.split_csv),
        "split": args.split,
        "audio_dir": str(args.audio_dir),
        "textgrid_dir": str(args.textgrid_dir),
        "models": {
            spec.name: {
                "checkpoint": getattr(args, spec.checkpoint_attr),
                "stats": getattr(args, spec.stats_attr),
            }
            for spec in MODEL_SPECS
        },
    }
    with open(output_dir / "manifest.json", "w") as f:
        json.dump(manifest, f, indent=2)


def create_clip_folder(args: argparse.Namespace, clip_id: str, output_dir: Path) -> Path:
    clip_dir = output_dir / clip_id
    clip_dir.mkdir(parents=True, exist_ok=True)

    copy_asset(Path(args.audio_dir) / f"{clip_id}.wav", clip_dir / f"{clip_id}.wav", required=True)
    copy_asset(
        Path(args.textgrid_dir) / f"{clip_id}.TextGrid",
        clip_dir / f"{clip_id}.TextGrid",
        required=not args.allow_missing_textgrid,
    )

    for spec in MODEL_SPECS:
        run_model_inference(args, spec, clip_id, clip_dir)

    return clip_dir


def worker_main(args: argparse.Namespace) -> None:
    output_dir = Path(args.output_dir)
    clip_ids = choose_clip_ids(args)
    if args.dry_run:
        print("[DRY-RUN] Worker would process:")
        for clip_id in clip_ids:
            print(f"  {clip_id}")
        print(f"[DRY-RUN] Remote output directory would be: {output_dir.resolve()}")
        return

    output_dir.mkdir(parents=True, exist_ok=True)
    write_manifest(args, clip_ids, output_dir)

    print(f"[SETUP] Selected {len(clip_ids)} clips")
    print(f"[SETUP] Output directory: {output_dir.resolve()}")
    failures = []
    for idx, clip_id in enumerate(clip_ids, start=1):
        print("\n" + "=" * 80)
        print(f"[CLIP] {idx}/{len(clip_ids)} {clip_id}")
        print("=" * 80)
        try:
            clip_dir = create_clip_folder(args, clip_id, output_dir)
            print(f"[DONE] {clip_id}: {clip_dir.resolve()}")
        except Exception as exc:
            if not args.continue_on_error:
                raise
            print(f"[WARN] Failed {clip_id}: {exc}")
            failures.append({"clip_id": clip_id, "error": str(exc)})

    if failures:
        failure_path = output_dir / "failed_gesture_questions.json"
        with open(failure_path, "w") as f:
            json.dump(failures, f, indent=2)
        print(f"[DONE] Completed with {len(failures)} failures: {failure_path}")
    else:
        print("[DONE] Completed without failures")


